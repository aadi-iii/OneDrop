rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Phase 2C: user documents now also include a required `phone`
      // (WhatsApp/mobile) field, written at signup and editable from My
      // Profile. No rule change was needed — it's just another field
      // covered by the existing owner-only write rule below.
      allow read: if request.auth != null;

      // Phase 4A: owners can still write their own profile, but a write can
      // never SET role to "admin" unless the document already had role ==
      // "admin" beforehand. This closes off a client-side privilege
      // escalation path (a donor/receiver editing their own doc to grant
      // themselves admin access) while leaving every existing donor/receiver
      // write untouched, and still letting an already-admin account save its
      // own profile normally. Admin accounts must still be granted manually
      // (e.g. via the Firebase console) — this phase does not add a way to
      // create admins from the client.
      allow write: if request.auth != null && request.auth.uid == userId
                   && (
                     request.resource.data.role != "admin" ||
                     (resource != null && resource.data.role == "admin")
                   );
    }

    match /bloodRequests/{requestId} {
      // Donors need to browse all requests; receivers need to see their own.
      allow read: if request.auth != null;

      // Only a receiver can create a request, only for themselves, and it
      // must start life as "Pending".
      allow create: if request.auth != null
                    && request.resource.data.receiverId == request.auth.uid
                    && request.resource.data.status == "Pending";

      // Updates allowed only for these exact transitions:
      //  1) The owning receiver cancels their own still-Pending request
      //     (Pending -> Cancelled), changing no other field.
      //  2) Any signed-in donor rejects a still-Pending request
      //     (Pending -> Rejected).
      //  3) Any signed-in donor accepts a still-Pending request
      //     (Pending -> Accepted), and MUST stamp their own UID into
      //     acceptedByUid (Phase 2C contact-sharing) — a donor can never
      //     write another donor's UID into this field.
      allow update: if request.auth != null && (
        (
          resource.data.receiverId == request.auth.uid &&
          resource.data.status == "Pending" &&
          request.resource.data.status == "Cancelled"
        ) ||
        (
          resource.data.status == "Pending" &&
          request.resource.data.status == "Rejected"
        ) ||
        (
          resource.data.status == "Pending" &&
          request.resource.data.status == "Accepted" &&
          request.resource.data.acceptedByUid == request.auth.uid
        )
      );

      allow delete: if false; // history is preserved — status changes only, no deletes
    }

    match /notifications/{notifId} {
      // A user only ever reads/updates/deletes their OWN notifications.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Notifications are written by a DIFFERENT user's action (e.g. a donor
      // accepting creates a notification for the receiver), so we can't
      // require the creator to own it — instead just require the writer to
      // be signed in and the doc to be well-formed and start unread.
      allow create: if request.auth != null
                    && request.resource.data.userId is string
                    && request.resource.data.isRead == false;

      // Only the notification's owner can mark it read or delete it.
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
